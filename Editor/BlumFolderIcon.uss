.blum-root { padding: 16px; background-color: #28292c; color: #eeeef0; }
.blum-root.light { background-color: #e6e7e9; color: #242629; }
.header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.title { font-size: 22px; -unity-font-style: bold; }
.muted { color: #a2a5ac; font-size: 11px; }
.light .muted { color: #555a64; }
.options { flex-direction: row; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }
.options > Toggle { margin-right: 10px; }
.options > Button { margin-left: auto; }
.body { flex-grow: 1; }
.selection-title { font-size: 15px; -unity-font-style: bold; margin-top: 4px; margin-bottom: 8px; white-space: normal; }
.preview { flex-direction: row; align-items: center; justify-content: center; min-height: 128px; background-color: #303236; border-radius: 6px; margin-bottom: 12px; }
.light .preview { background-color: #f6f6f7; }
.preview-slot { align-items: center; justify-content: center; margin-left: 20px; margin-right: 20px; }
.preview-slot > Label { font-size: 10px; color: #a2a5ac; margin-top: 6px; }
.light .preview-slot > Label { color: #636670; }
.section-title { font-size: 12px; -unity-font-style: bold; margin-top: 8px; margin-bottom: 6px; }
.field-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.color-field { flex-grow: 1; margin-left: 12px; }
.palette { flex-direction: row; margin-top: 4px; margin-bottom: 8px; }
.swatch { width: 32px; height: 26px; margin-right: 6px; margin-left: 0; border-width: 1px; border-color: rgba(255,255,255,0.25); border-radius: 4px; }
.swatch:hover { border-color: white; border-width: 2px; }
.glyph-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; }
.glyph-button { width: 44px; height: 36px; margin: 0 6px 6px 0; padding: 6px; align-items: center; justify-content: center; background-color: #383b40; border-width: 1px; border-color: #50535a; border-radius: 4px; font-size: 10px; }
.glyph-button:hover { background-color: #494c52; }
.glyph-button.chosen { border-color: #f4796d; border-width: 2px; }
.glyph { width: 22px; height: 22px; }
.hint { font-size: 11px; color: #aaaeb6; white-space: normal; margin-top: 8px; margin-bottom: 8px; }
.light .hint { color: #555b65; }
.footer { flex-direction: row; justify-content: flex-end; margin-top: 12px; padding-top: 12px; border-top-width: 1px; border-top-color: #494b52; flex-shrink: 0; }
.footer > Button { min-height: 28px; padding-left: 9px; padding-right: 9px; }
.primary { background-color: #c65c51; color: white; min-width: 75px; border-width: 0; }
.primary:hover { background-color: #ad4d44; }
.rule { background-color: #303236; padding: 9px; border-radius: 4px; margin-bottom: 8px; }
.light .rule { background-color: #f3f3f5; }
